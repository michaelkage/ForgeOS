NODE_ENV=development
PORT=4100
HOST=127.0.0.1
# Comma-separated trusted reverse-proxy IPs/CIDRs; leave empty when no trusted proxy is used.
TRUST_PROXY=
DATABASE_URL=postgres://forgeos:change-me@localhost:5432/forgeos
WEB_ORIGIN=http://127.0.0.1:4100
SESSION_COOKIE_NAME=forgeos_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# Keep builds disabled until isolated Android workers and artifact storage are deployed.
ENABLE_ANDROID_BUILDS=false
# Required when ENABLE_ANDROID_BUILDS=true. Generate at least 32 random bytes; never expose to browsers.
BUILD_WORKER_SHARED_SECRET=

# Required before enabling builds. Use a private S3 bucket with public access blocked and TLS.
# Credentials must be scoped to this bucket; never expose them to workers or browsers.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional fine-grained GitHub token with public repository metadata/content read access.
GITHUB_TOKEN=
