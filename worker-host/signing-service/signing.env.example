# Bind only to a private management interface. Restrict inbound TCP/9444 to the platform API.
FORGEOS_SIGNING_LISTEN=10.0.0.20:9444
FORGEOS_SIGNING_TLS_CERT=/etc/forgeos-signing/tls/server.crt
FORGEOS_SIGNING_TLS_KEY=/etc/forgeos-signing/tls/server.key
FORGEOS_SIGNING_CLIENT_CA=/etc/forgeos-signing/tls/platform-client-ca.pem
FORGEOS_SIGNING_BEARER_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FORGEOS_SIGNING_JAVA=/usr/lib/jvm/java-21-openjdk-amd64/bin/java
FORGEOS_SIGNING_JARSIGNER=/usr/lib/jvm/java-21-openjdk-amd64/bin/jarsigner
FORGEOS_SIGNING_SIGNAPK_JAR=/opt/forgeos-signing/signapk.jar
FORGEOS_SIGNING_CERT=/etc/forgeos-signing/release/releasekey.x509.pem
FORGEOS_SIGNING_PRIVATE_KEY=/etc/forgeos-signing/release/releasekey.pk8
FORGEOS_SIGNING_WORKDIR=/var/lib/forgeos-signing
FORGEOS_SIGNING_MAX_BYTES=21474836480
FORGEOS_SIGNING_TIMEOUT_SECONDS=3600
