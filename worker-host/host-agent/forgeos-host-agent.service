[Unit]
Description=ForgeOS privileged Firecracker host agent and internal scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Slice=forgeos-host.slice
EnvironmentFile=/etc/forgeos/host-agent.env
WorkingDirectory=/var/lib/forgeos-host-agent
StateDirectory=forgeos-host-agent
StateDirectoryMode=0700
ExecStart=/usr/local/sbin/forgeos-host-agent
Restart=on-failure
RestartSec=5
TimeoutStopSec=infinity
KillMode=mixed
Delegate=yes
UMask=0077
LimitNOFILE=65536
LimitMEMLOCK=infinity
NoNewPrivileges=no
PrivateDevices=no
PrivateNetwork=no
PrivateTmp=no
PrivateMounts=no
ProtectSystem=full
ProtectHome=yes
ProtectControlGroups=no
ProtectKernelTunables=no
ProtectKernelModules=no
RestrictNamespaces=no
RestrictSUIDSGID=no
ReadWritePaths=/srv/forgeos-jailer /sys/fs/cgroup /run/netns /dev/kvm
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
