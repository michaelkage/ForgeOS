HOST_AGENT_CONFIG=/etc/forgeos/host-agent.json
HOST_AGENT_TOKEN=REPLACE_WITH_A_RANDOM_32_BYTE_OR_LONGER_SECRET
HOST_AGENT_SIGNING_KEY=/etc/forgeos/host-agent-signing.pem
HOST_AGENT_TLS_CERT=/etc/forgeos/host-agent.crt
HOST_AGENT_TLS_KEY=/etc/forgeos/host-agent.key
HOST_AGENT_LISTEN=0.0.0.0:9443
FORGEOS_SCHEDULER_ENABLED=false
PLATFORM_WORKER_TOKEN=REPLACE_WITH_BUILD_WORKER_SHARED_SECRET
